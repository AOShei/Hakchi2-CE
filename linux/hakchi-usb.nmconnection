# NetworkManager profile for the console's USB network link (interface
# "hakchi0", named by 99-hakchi.rules). The console uses the link-local
# address 169.254.13.37/16 and runs no DHCP server, so the host side must use
# a link-local address too; this is what Windows does automatically (APIPA).
# The connection is placed in firewalld's "trusted" zone so the console's mDNS
# announcements are not dropped (the setting is ignored when firewalld is not
# installed).
#
# Install to /etc/NetworkManager/system-connections/ with mode 0600, owned by
# root, then run "nmcli connection reload" (install-system.sh does this).
[connection]
id=hakchi USB
uuid=7f9d376e-f159-4449-b8f5-3e98058c9670
type=ethernet
autoconnect-priority=100
interface-name=hakchi0
zone=trusted

[ethernet]

[ipv4]
method=link-local

[ipv6]
addr-gen-mode=default
method=link-local

[proxy]
