<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ce_data</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- On Windows the bundled busybox.exe provides sh/tar/etc.; on Unix the native tools are used directly. -->
    <BusyBox Condition="'$(OS)' == 'Windows_NT'">&quot;./busybox&quot;</BusyBox>
  </PropertyGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="cd /D &quot;$(SolutionDir)tools&quot; || cd &quot;$(SolutionDir)tools&quot;&#xD;&#xA;$(BusyBox) mkdir -p &quot;../GeneratedData&quot;&#xD;&#xA;$(BusyBox) sh -e &quot;./downloadfiles&quot; &quot;../GeneratedData&quot;&#xD;&#xA;&#xD;&#xA;$(BusyBox) mv &quot;../GeneratedData/mods/hmods/hakchi.hmod&quot; &quot;../hakchi_gui/mods/hmods/hakchi.hmod&quot;&#xD;&#xA;$(BusyBox) tar -cvf &quot;../GeneratedData/basehmods.tar&quot; -C &quot;../hakchi_gui/mods/hmods&quot; &quot;.&quot;&#xD;&#xA;$(BusyBox) mv &quot;../hakchi_gui/mods/hmods/hakchi.hmod&quot; &quot;../GeneratedData/mods/hmods/hakchi.hmod&quot;&#xD;&#xA;$(BusyBox) sh -e &quot;./copypackedhmods&quot; &quot;../hakchi_gui/mods/hmods&quot; &quot;../GeneratedData/user_mods&quot;&#xD;&#xA;&#xD;&#xA;$(BusyBox) cp -R &quot;../hakchi_gui/user_mods/&quot; &quot;../GeneratedData/&quot;&#xD;&#xA;$(BusyBox) rm &quot;../GeneratedData/data/libretro_cores.tar&quot;&#xD;&#xA;$(BusyBox) rm &quot;../GeneratedData/data/desktop_entries.tar&quot;&#xD;&#xA;$(BusyBox) rm &quot;../GeneratedData/data/original_art.tar&quot;&#xD;&#xA;$(BusyBox) tar -cvf &quot;../GeneratedData/data/libretro_cores.tar&quot; -C &quot;../hakchi_gui/data/libretro_cores/&quot; &quot;.&quot;&#xD;&#xA;$(BusyBox) tar -cvf &quot;../GeneratedData/data/desktop_entries.tar&quot; -C &quot;../hakchi_gui/data/desktop_entries/&quot; &quot;.&quot;&#xD;&#xA;$(BusyBox) tar -cvf &quot;../GeneratedData/data/original_art.tar&quot; -C &quot;../hakchi_gui/data/original_art/&quot; &quot;.&quot;&#xD;&#xA;$(BusyBox) tar -cvf &quot;../GeneratedData/data/licenses.tar&quot; -C &quot;../hakchi_gui/Licenses/&quot; &quot;.&quot;" />
  </Target>

</Project>
